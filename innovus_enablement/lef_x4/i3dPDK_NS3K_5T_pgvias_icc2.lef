    RECT -0.1800 -0.0200 -0.1400 0.0200 ;
    RECT -0.1000 -0.0200 -0.0600 0.0200 ;
    RECT -0.0200 -0.0200 0.0200 0.0200 ;
    RECT 0.0600 -0.0200 0.1000 0.0200 ;
    RECT 0.1400 -0.0200 0.1800 0.0200 ;
END PGVIA01_1_5

